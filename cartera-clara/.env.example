# Copia a .env. Nunca subas .env al repositorio.

# Solo necesaria para las funciones de IA (importador IA, conciliador AEAT, asistente).
# El cálculo fiscal funciona sin clave.
ANTHROPIC_API_KEY=

# Modelos (docs/00-documento-de-diseno.md §7.4, ADR 0005).
CC_MODELO_PRINCIPAL=claude-opus-5
CC_MODELO_EXTRACCION=claude-opus-5

# Motor de referencia DeclaRenta (docs/referencias/declarenta-integracion.md).
# Orden a ejecutar; por defecto la CLI instalada en vendor/declarenta.
CC_DECLARENTA_CMD=node vendor/declarenta/dist/cli.js

# Datos locales (nunca salen de tu equipo).
CC_DIR_DATOS=data
