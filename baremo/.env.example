# Copia este fichero a .env y rellena lo que necesites. .env NUNCA se sube al repositorio.

# Obligatoria solo para extraer pliegos y redactar borradores (fases F3 y F5).
# La ingesta, el motor determinista, el recomendador y la web funcionan sin ella.
ANTHROPIC_API_KEY=

# Modelos (ver docs/00-documento-de-diseno.md §7.4 y ADR 0004).
BAREMO_MODELO_PRINCIPAL=claude-opus-5
BAREMO_MODELO_EXTRACCION=claude-opus-5

# Rutas de datos (relativas a la carpeta baremo/).
BAREMO_DIR_DATOS=data
BAREMO_DB=data/baremo.duckdb

# Cortesía con PLACSP: segundos de espera entre descargas de pliegos.
BAREMO_PAUSA_DESCARGA_S=2.0
